# Application Name
NAME="Janakpur Hackathon Anonymous Reporting Backend"
APP_NAME="Janakpur Hackathon Anonymous Reporting Backend"

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Leave blank to use embedded in-memory MongoDB, or specify your MongoDB connection string
# Example: mongodb://127.0.0.1:27017/anonymous_vault
MONGO_URI=

# Security & Authentication
JWT_SECRET=supersecretjwtkey12345
JWT_EXPIRE=30d
AES_SECRET=a9f3b1c7d5e2f8a0c4b6d7e9f1a2b3c4

# Cloudinary Storage (Optional - falls back to local storage if not configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
