# =================================================================
# Janakpur Hackathon - Anonymous Incident Reporting Platform
# Global Environment Variables Reference
# =================================================================

# Application Name
NAME="Janakpur Hackathon - Anonymous Incident Reporting & Evidence Vault"
APP_NAME="Anonymous Reporting & Evidence Vault"

# -----------------------------------------------------------------
# 1. Backend Service (Node.js + Express) - backend/
# -----------------------------------------------------------------
BACKEND_NAME="Anonymous Reporting Backend API"
BACKEND_PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave empty for automatic in-memory MongoDB)
MONGO_URI=

# Security
JWT_SECRET=supersecretjwtkey12345
JWT_EXPIRE=30d
AES_SECRET=a9f3b1c7d5e2f8a0c4b6d7e9f1a2b3c4

# Cloudinary (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------
# 2. FastAPI AI Service (Python) - backend_fastapi/
# -----------------------------------------------------------------
FASTAPI_NAME="Nepal Legal Chatbot API"
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
# Google Gemini API Key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# -----------------------------------------------------------------
# 3. Frontend Web App (React) - frontend/
# -----------------------------------------------------------------
FRONTEND_NAME="Anonymous Reporting Web Application"
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_CHAT_API_URL=http://localhost:8000/api
FRONTEND_PORT=3000

# -----------------------------------------------------------------
# 4. Admin Panel (React + Vite) - admin_panel/
# -----------------------------------------------------------------
ADMIN_PANEL_NAME="NGO & Administrator Dashboard"
VITE_API_URL=http://localhost:5000/api
ADMIN_PANEL_PORT=5173
